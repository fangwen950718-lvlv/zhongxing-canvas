{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "zhongxing-canvas",
  "version": "2.0.3",
  "description": "众行无限画布：本地优先的视觉方案、画布编辑、生图与标注修改工作流。",
  "author": {
    "name": "众行"
  },
  "repository": "https://github.com/fangwen950718-lvlv/zhongxing-canvas",
  "homepage": "https://github.com/fangwen950718-lvlv/zhongxing-canvas",
  "license": "MIT",
  "keywords": [
    "canvas",
    "excalidraw",
    "image-generation",
    "local-first"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "众行无限画布",
        "shortDescription": "在 Codex 中构思、绘制并一键生图。",
        "longDescription": "自包含 Excalidraw 画布，包含三组视觉方案、审美规则库、参考图、生图和箭头标注修改。无需本机 Vite 服务。",
        "developerName": "众行",
        "category": "Productivity",
        "capabilities": [
          "Interactive",
          "Image generation",
          "Local-first"
        ],
        "defaultPrompt": [
          "打开众行无限画布。"
        ]
      }
    }
  }
}
