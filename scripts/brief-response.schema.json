{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "options": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "proposal": { "type": "string", "minLength": 1, "maxLength": 30000 },
          "sections": {
            "type": "array",
            "minItems": 4,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "label": { "type": "string", "minLength": 1, "maxLength": 40 },
                "content": { "type": "string", "minLength": 1, "maxLength": 5000 }
              },
              "required": ["label", "content"]
            }
          },
          "imagePrompt": { "type": "string", "minLength": 1, "maxLength": 30000 }
        },
        "required": ["title", "proposal", "sections", "imagePrompt"]
      }
    }
  },
  "required": ["options"]
}
